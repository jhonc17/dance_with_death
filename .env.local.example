# Copy this to `.env.local` and fill it in before running ./deploy
# `.env.local` is gitignored.

# --- App ---
APP_NAME="Dance with Death"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
# Optional. If unset, ./deploy picks a free port near 3000 / 8000.
# FRONTEND_PORT=3000
# BACKEND_PORT=8000
# Public booking URL used in cancellation emails. Defaults to http://localhost:<FRONTEND_PORT>.
# FRONTEND_URL=http://localhost:3000

# --- PostgreSQL (runs in Docker; data stays on the host) ---
DB_HOST=postgres
DB_DATABASE=dance_with_death
DB_USERNAME=dance
DB_PASSWORD=dance_secret
POSTGRES_DATA_PATH=./data/postgres

# --- Mail ---
# log = dump mail to the backend logs
# smtp = Gmail or any other SMTP (MAIL_USERNAME + MAIL_PASSWORD)
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Dance with Death"
# Gmail: 2FA, then an app password at https://myaccount.google.com/apppasswords
